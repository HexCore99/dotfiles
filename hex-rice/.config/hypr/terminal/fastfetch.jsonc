{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // The Zsh wrapper supplies a random image. Keep output compact and native:
    // no network lookups, package scans, or shell commands during startup.
    "logo": {
        "type": "small",
        "padding": { "left": 1, "right": 3, "top": 1 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "blue", "title": "cyan" },
        "key": { "width": 14 }
    },
    "modules": [
        "break",
        "title",
        { "type": "separator", "string": "─", "length": 28 },
        { "type": "os", "key": "󰣇  OS", "format": "{pretty-name}" },
        { "type": "kernel", "key": "  Kernel", "format": "{release}" },
        { "type": "uptime", "key": "󰥔  Uptime" },
        { "type": "shell", "key": "  Shell" },
        { "type": "terminal", "key": "  Terminal" },
        { "type": "wm", "key": "  Desktop", "format": "{pretty-name}" },
        { "type": "memory", "key": "  Memory" },
        "break",
        { "type": "colors", "symbol": "circle" },
        "break"
    ]
}
