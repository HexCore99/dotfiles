+/* Keep keyboard selection visible without tying the view to fixed pages. */
+static void
+keep_selection_visible(struct matches *matches)
+{
+    const size_t count = matches->match_count;
+    const size_t rows = matches->max_matches_per_page;
+    if (count == 0 || rows == 0) {
+        matches->selected = 0;
+        matches->first_visible = 0;
+        return;
+    }
+    if (matches->selected >= count)
+        matches->selected = count - 1;
+    if (matches->selected < matches->first_visible)
+        matches->first_visible = matches->selected;
+    else if (matches->selected - matches->first_visible >= rows)
+        matches->first_visible = matches->selected - rows + 1;
+    const size_t last_start = count > rows ? count - rows : 0;
+    if (matches->first_visible > last_start)
+        matches->first_visible = last_start;
+}
 
