+/* Pointer scrolling moves the view one row, even over a middle list entry.
+ * Preserve the selected row; the caller can then select the hovered row. */
+bool
+matches_scroll(struct matches *matches, bool down)
+{
+    const size_t rows = matches->max_matches_per_page;
+    if (rows == 0 || matches->match_count <= rows)
+        return false;
+    const size_t last_start = matches->match_count - rows;
+    const size_t first = matches->first_visible;
+    if ((down && first >= last_start) || (!down && first == 0))
+        return false;
+    const size_t selected_row = matches->selected - first;
+    matches->first_visible = down ? first + 1 : first - 1;
+    matches->selected = matches->first_visible + selected_row;
+    return true;
 }
 
