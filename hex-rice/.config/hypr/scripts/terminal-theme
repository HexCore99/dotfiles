#!/bin/sh
# Generate a terminal-only pywal palette. Wallpaper application never waits for
# this worker, and opening a shell only reads the already generated colors.
set -eu
config="$HOME/.config/hypr"
terminal="$config/terminal"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/hypr-terminal"
mkdir -p "$cache"
# Resolve the latest wallpaper AFTER taking the lock, so rapid selections settle
# on the most recent image. Repeated queued requests reuse the completed palette.
exec 9>"$cache/theme.lock"
flock 9
wallpaper=$(readlink -f "$config/wallpaper/current")
[ -f "$wallpaper" ] || exit 0
fingerprint=$( { printf '%s\n' "$wallpaper"; stat -Lc '%d:%i:%s:%y' "$wallpaper"; } | sha256sum | cut -d ' ' -f 1)
if [ "${1:-}" != --force ] && [ -f "$cache/theme-source" ] &&
    [ "$(cat "$cache/theme-source")" = "$fingerprint" ]; then
    exit 0
fi

# -n leaves Hyprpaper in charge. -s -t -e prevent global terminal, TTY and
# desktop reloads; only Kitty is reloaded after its new palette is ready.
export PYWAL_CACHE_DIR="$cache/wal"
export NO_FUN=1
export EASTEREGGS=0
export PATH="$terminal/vendor/usr/bin:$PATH"
timeout 45 "$terminal/tools/bin/wal" -i "$wallpaper" --backend colorthief \
    --cols16 lighten -b 181b20 --fg e5e8eb -n -s -t -e

temporary=$(mktemp "$terminal/.colors.XXXXXX")
trap 'rm -f "$temporary"' EXIT HUP INT TERM
# JSON parsing safely handles any wallpaper filename; never source generated code.
jq -er '
    "# Generated by scripts/terminal-theme using pywal16. Do not edit.\n" +
    "background " + .special.background + "\n" +
    "foreground " + .special.foreground + "\n" +
    "cursor " + .colors.color6 + "\n" +
    "selection_background " + .colors.color4 + "\n" +
    "selection_foreground " + .special.background + "\n" +
    ([range(0;16) as $i | "color\($i) " + .colors["color\($i)"]] | join("\n")) + "\n" +
    "active_tab_foreground " + .colors.color6 + "\n" +
    "active_tab_background " + .special.background + "\n" +
    "inactive_tab_foreground " + .colors.color8 + "\n" +
    "inactive_tab_background " + .special.background
' "$cache/wal/colors.json" > "$temporary"
chmod 644 "$temporary"
mv -f "$temporary" "$terminal/colors.conf"
printf '%s\n' "$fingerprint" > "$cache/theme-source"
# SIGUSR1 is Kitty's native configuration reload, preserving running commands.
pkill -USR1 -u "$(id -u)" -x kitty || true
